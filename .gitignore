# IRPF declaration files anywhere outside fixtures/ are PII.
# fixtures/ is allowed to contain ONLY synthetic, redacted data.
*.DBK
*.DEC
*.REC
*.dbk
*.dec
*.rec
!fixtures/*.DBK
!fixtures/*.DEC
!fixtures/*.dbk
!fixtures/*.dec
